#!/usr/bin/env bash

set -euo pipefail

monitors=$(hyprctl monitors all)
[[ $monitors == *ULTRAGEAR* ]] || exit 0
# Keep the laptop display enabled when no external output is connected.
if ! printf '%s\n' "$monitors" | grep -Eq '^Monitor (HDMI-A-1|DP-1) '; then
    exit 0
fi

hyprctl eval '
hl.monitor({ output = "DP-1", mode = "preferred", position = "0x0", scale = 1, disabled = false, transform = 1, mirror = "" })
hl.monitor({ output = "DP-3", mode = "preferred", position = "1080x0", scale = 1, disabled = false, transform = 0, mirror = "" })
hl.monitor({ output = "eDP-1", disabled = true })
'
