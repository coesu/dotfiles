#!/usr/bin/env bash

set -euo pipefail

hyprctl eval '
hl.monitor({ output = "eDP-1", mode = "preferred", position = "0x1080", scale = 1, disabled = false, transform = 0, mirror = "" })
hl.monitor({ output = "HDMI-A-1", mode = "preferred", position = "0x0", scale = 1, disabled = false, transform = 0, mirror = "" })
hl.monitor({ output = "DP-1", mode = "preferred", position = "1920x1080", scale = 1, disabled = false, transform = 0, mirror = "" })
'
